# Copy this file to `.env` and fill in the values. NEVER commit the real .env.

# MongoDB connection string (MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/angelfireworks?appName=Cluster0

# Port (Render sets this automatically in production)
PORT=5001

# Secret for signing admin JWTs — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Bootstrap Super Admin (used by `npm run create-admin`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Cloudinary — image hosting (get these from your Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production CORS: the deployed frontend URLs (leave blank in local dev to allow all)
CLIENT_URL=
ADMIN_URL=
